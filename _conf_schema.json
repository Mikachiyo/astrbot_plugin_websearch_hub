{
  "providers": {
    "description": "🔎 搜索提供商列表（按顺序轮询回退）",
    "type": "template_list",
    "hint": "列表顺序即优先级：第一个失败后自动换下一个。每个提供商可填多个 API Key 轮询使用。base_url 全部可改为中转地址；用中转时记得把请求协议改成中转实际支持的格式。",
    "templates": {
      "gemini_search": {
        "name": "Gemini 谷歌原生搜索",
        "hint": "预设：Google 官方 generateContent + google_search grounding。走中转时请按中转支持的格式调整请求协议。",
        "items": {
          "name": {
            "description": "自定义名称",
            "type": "string",
            "default": "gemini"
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "astr_provider_id": {
            "description": "从 AstrBot 已配置提供商选择（可选）",
            "type": "string",
            "default": "",
            "_special": "select_provider",
            "hint": "选择后自动继承该提供商的 API 地址、Key 列表和模型，下方 base_url / model / api_keys 将被忽略。若面板不支持下拉，可直接粘贴提供商 ID。"
          },
          "protocol": {
            "description": "请求协议",
            "type": "string",
            "default": "auto",
            "options": [
              "auto",
              "gemini_native",
              "openai_responses",
              "openai_chat_search",
              "tavily"
            ],
            "hint": "auto=选择了 AstrBot 提供商时按其适配器类型自动推断，未选时按模板预设；其余选项为手动指定请求格式。gemini_native=Google generateContent; openai_responses=Responses API 的 web_search（多数中转用这种）; openai_chat_search=chat/completions + search_parameters（xAI 风格）; tavily=Tavily API"
          },
          "base_url": {
            "description": "API 地址（可填中转）",
            "type": "string",
            "default": "https://generativelanguage.googleapis.com"
          },
          "model": {
            "description": "模型",
            "type": "string",
            "default": "gemini-2.5-flash"
          },
          "api_keys": {
            "description": "API Key 列表（可多个，轮询使用）",
            "type": "list",
            "default": []
          },
          "timeout": {
            "description": "超时(秒)",
            "type": "int",
            "default": 60
          },
          "max_results": {
            "description": "最大结果数",
            "type": "int",
            "default": 0,
            "hint": "0 = 不限制"
          }
        }
      },
